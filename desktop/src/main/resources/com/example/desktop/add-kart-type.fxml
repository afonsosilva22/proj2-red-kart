<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox spacing="15" alignment="CENTER" prefWidth="350" prefHeight="220"
      xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.example.desktop.controllers.AddKartTypeController">

    <padding>
        <Insets top="20" right="20" bottom="20" left="20"/>
    </padding>

    <Label text="New Kart Category" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>

    <GridPane hgap="10" vgap="15">
        <columnConstraints>
            <ColumnConstraints minWidth="100" />
            <ColumnConstraints hgrow="ALWAYS" />
        </columnConstraints>

        <Label text="Category Name:" GridPane.rowIndex="0" GridPane.columnIndex="0" />
        <TextField fx:id="txtType" promptText="e.g. standard, pro, twin" GridPane.rowIndex="0" GridPane.columnIndex="1" />

        <Label text="Price/Hour (€):" GridPane.rowIndex="1" GridPane.columnIndex="0" />
        <TextField fx:id="txtPrice" promptText="0.00" GridPane.rowIndex="1" GridPane.columnIndex="1" />
    </GridPane>

    <HBox spacing="10" alignment="CENTER_RIGHT" style="-fx-padding: 10 0 0 0;">
        <Button text="Cancel" onAction="#cancel" />
        <Button text="Save Category" onAction="#saveType" style="-fx-base: #5cb85c; -fx-text-fill: white; -fx-font-weight: bold;" />
    </HBox>
</VBox>