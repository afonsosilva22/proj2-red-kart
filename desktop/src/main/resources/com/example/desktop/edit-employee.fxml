<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.example.desktop.controllers.EditEmployeeController"
      spacing="10"
      prefWidth="400"
      prefHeight="540"
      style="-fx-padding: 20;">

    <Label text="Edit Employee Profile"
           style="-fx-font-size: 18px; -fx-font-weight: bold;" />

    <TextField fx:id="nameField" promptText="Full Name" />
    <TextField fx:id="nifField" promptText="NIF" />
    <TextField fx:id="emailField" promptText="Email Address" />
    <TextField fx:id="phoneField" promptText="Phone Number" />

    <HBox spacing="10" alignment="CENTER_LEFT">
        <DatePicker fx:id="birthdatePicker" promptText="Birthdate" HBox.hgrow="ALWAYS" prefWidth="240" />
        <ComboBox fx:id="typeComboBox" promptText="Role Type" HBox.hgrow="ALWAYS" prefWidth="120" />
    </HBox>

    <Separator style="-fx-padding: 5 0 5 0;"/>
    <Label text="Address Details" style="-fx-font-weight: bold; -fx-text-fill: #555;" />

    <HBox spacing="10">
        <TextField fx:id="streetField" promptText="Street" HBox.hgrow="ALWAYS" />
        <TextField fx:id="doorNumberField" promptText="Door No." prefWidth="80" />
    </HBox>

    <HBox spacing="10">
        <TextField fx:id="postalCodeField" promptText="Postal Code" prefWidth="120" />
        <TextField fx:id="localityField" promptText="Locality" HBox.hgrow="ALWAYS" />
    </HBox>

    <Separator style="-fx-padding: 5 0 5 0;"/>

    <HBox spacing="10" alignment="CENTER_RIGHT">
        <Button text="Cancel" onAction="#cancel" prefWidth="100" />
        <Button text="Update Employee" onAction="#updateEmployee" prefWidth="160"
                style="-fx-font-weight: bold; -fx-base: #337ab7; -fx-text-fill: white;" />
    </HBox>

</VBox>