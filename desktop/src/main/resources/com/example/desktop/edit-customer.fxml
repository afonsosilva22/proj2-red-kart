<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.example.desktop.controllers.EditCustomerController"
      spacing="10"
      prefWidth="400"
      prefHeight="500"
      style="-fx-padding: 20;">

    <Label text="Edit Customer"
           style="-fx-font-size: 18px; -fx-font-weight: bold;" />

    <TextField fx:id="nameField" promptText="Name" />
    <TextField fx:id="nifField" promptText="NIF" />
    <TextField fx:id="emailField" promptText="Email" />
    <TextField fx:id="phoneField" promptText="Phone" />
    <DatePicker fx:id="birthdatePicker" promptText="Birthdate" prefWidth="400" />

    <Separator style="-fx-padding: 5 0 5 0;"/>
    <Label text="Address Details" style="-fx-font-weight: bold; -fx-text-fill: #555;" />

    <HBox spacing="10">
        <TextField fx:id="streetField" promptText="Street" HBox.hgrow="ALWAYS" />
        <TextField fx:id="doorNumberField" promptText="Door No." prefWidth="80" />
    </HBox>

    <HBox spacing="10">
        <TextField fx:id="postalCodeField" promptText="Postal Code" prefWidth="120" />
        <TextField fx:id="localityField" promptText="Locality" HBox.hgrow="ALWAYS" />
    </HBox>

    <Separator style="-fx-padding: 5 0 5 0;"/>

    <HBox spacing="10" alignment="CENTER_RIGHT">
        <Button text="Cancel"
                onAction="#cancel"
                prefWidth="100" />
        <Button text="Update Customer"
                onAction="#updateCustomer"
                prefWidth="150"
                style="-fx-font-weight: bold; -fx-base: #337ab7; -fx-text-fill: white;" />
    </HBox>

</VBox>