<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane prefHeight="500.0" prefWidth="700.0"
            xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.example.desktop.controllers.RentalController">

    <children>
        <VBox spacing="10" AnchorPane.topAnchor="10"
              AnchorPane.leftAnchor="10"
              AnchorPane.rightAnchor="10"
              AnchorPane.bottomAnchor="10">

            <HBox spacing="10">
                <Button text="Refresh Table" onAction="#loadRentals"/>
                <Button text="Add Rental" onAction="#addRental"/>
                <Button fx:id="btnSetupRace" text="Setup Race" onAction="#setupRace" disable="true" style="-fx-font-weight: bold; -fx-base: #f0ad4e; -fx-text-fill: white;" />
            </HBox>

            <TableView fx:id="rentalTable" VBox.vgrow="ALWAYS" prefHeight="300">
                <columns>
                    <TableColumn fx:id="colId" text="ID" prefWidth="60"/>
                    <TableColumn fx:id="colCustomer" text="Customer" prefWidth="180"/>
                    <TableColumn fx:id="colStart" text="Planned Start" prefWidth="160"/>
                    <TableColumn fx:id="colEnd" text="Planned End" prefWidth="160"/>
                    <TableColumn fx:id="colPrice" text="Price" prefWidth="100"/>
                    <TableColumn fx:id="colType" text="Type" prefWidth="100"/>
                    <TableColumn fx:id="colStatus" text="Status" prefWidth="120"/>
                </columns>
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY_FLEX_LAST_COLUMN"/>
                </columnResizePolicy>
            </TableView>

            <VBox spacing="8" style="-fx-padding:10; -fx-border-color: lightgray; -fx-border-radius: 4; -fx-background-radius: 4;">
                <HBox alignment="CENTER_LEFT" spacing="10">
                    <Label text="Rental Details" style="-fx-font-size:16; -fx-font-weight:bold;" />
                    <Region HBox.hgrow="ALWAYS" />
                    <Button fx:id="btnEdit" text="Edit Rental" onAction="#editRental" disable="true" style="-fx-font-weight: bold;" />
                    <Button fx:id="btnRegisterPayment" text="Register Payment" onAction="#registerPayment" disable="true" style="-fx-font-weight: bold; -fx-base: #5cb85c; -fx-text-fill: white;" />
                    <Button fx:id="btnDelete" text="Delete" onAction="#deleteRental" disable="true" style="-fx-font-weight: bold; -fx-base: #d9534f; -fx-text-fill: white;" />
                </HBox>

                <Label fx:id="lblBasePrice" text="Base Price: "/>
                <Label fx:id="lblDiscount" text="Discount: "/>
                <Label fx:id="lblActualStart" text="Actual Start: "/>
                <Label fx:id="lblActualEnd" text="Actual End: "/>
                <Label fx:id="lblComplaint" text="Complaint: "/>
            </VBox>

        </VBox>
    </children>
</AnchorPane>