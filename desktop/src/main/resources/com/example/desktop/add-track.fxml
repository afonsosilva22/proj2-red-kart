<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox spacing="15" alignment="CENTER" prefWidth="400" prefHeight="280"
      xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.example.desktop.controllers.AddTrackController">
    <padding><Insets top="20" right="20" bottom="20" left="20"/></padding>

    <Label text="Register New Track Circuit" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>

    <GridPane hgap="10" vgap="10">
        <columnConstraints>
            <ColumnConstraints minWidth="130"/>
            <ColumnConstraints hgrow="ALWAYS"/>
        </columnConstraints>
        <children>
            <Label text="Track Name:" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
            <TextField fx:id="txtName" GridPane.rowIndex="0" GridPane.columnIndex="1"/>

            <Label text="Price Per Hour ($):" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
            <TextField fx:id="txtPrice" GridPane.rowIndex="1" GridPane.columnIndex="1"/>

            <Label text="Length (KM):" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
            <TextField fx:id="txtLength" GridPane.rowIndex="2" GridPane.columnIndex="1"/>

            <Label text="Max Kart Limit:" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
            <TextField fx:id="txtLimit" GridPane.rowIndex="3" GridPane.columnIndex="1"/>
        </children>
    </GridPane>

    <HBox spacing="10" alignment="CENTER_RIGHT">
        <Button text="Cancel" onAction="#cancel"/>
        <Button text="Save Circuit" onAction="#saveTrack" style="-fx-base: #5cb85c; -fx-text-fill: white; -fx-font-weight: bold;"/>
    </HBox>
</VBox>