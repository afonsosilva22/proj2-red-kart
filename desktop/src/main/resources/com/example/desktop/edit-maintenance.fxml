<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox spacing="15" alignment="CENTER" prefWidth="420" prefHeight="400"
      xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.example.desktop.controllers.EditMaintenanceController">

    <padding><Insets top="20" right="20" bottom="20" left="20"/></padding>

    <Label text="Update Ticket Status" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>

    <GridPane hgap="10" vgap="12">
        <columnConstraints>
            <ColumnConstraints minWidth="110"/>
            <ColumnConstraints hgrow="ALWAYS"/>
        </columnConstraints>
        <children>
            <Label text="Current Status:" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
            <ComboBox fx:id="comboStatus" maxWidth="Infinity" GridPane.rowIndex="0" GridPane.columnIndex="1"/>

            <Label text="Priority Level:" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
            <ComboBox fx:id="comboPriority" maxWidth="Infinity" GridPane.rowIndex="1" GridPane.columnIndex="1"/>

            <Label text="Assigned Mechanic:" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
            <ComboBox fx:id="comboEmployee" promptText="Unassigned" maxWidth="Infinity" GridPane.rowIndex="2" GridPane.columnIndex="1"/>

            <Label text="Ticket Notes:" GridPane.rowIndex="3" GridPane.columnIndex="0" GridPane.valignment="TOP"/>
            <TextArea fx:id="txtDescription" promptText="Add extra details or repair logs here..." prefRowCount="5" wrapText="true" GridPane.rowIndex="3" GridPane.columnIndex="1"/>
        </children>
    </GridPane>

    <Region VBox.vgrow="ALWAYS" />

    <HBox spacing="10" alignment="CENTER_RIGHT">
        <Button text="Cancel" onAction="#cancel"/>
        <Button text="Update Ticket" onAction="#updateMaintenance" style="-fx-base: #0275d8; -fx-text-fill: white; -fx-font-weight: bold;"/>
    </HBox>
</VBox>