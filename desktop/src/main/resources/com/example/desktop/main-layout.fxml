<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.example.desktop.controllers.MainLayoutController"
            prefHeight="600.0" prefWidth="900.0">

    <left>
        <VBox spacing="10" style="-fx-background-color: #2c3e50; -fx-padding: 20; -fx-width: 200;">
            <Label text="Red Kart App"
                   style="-fx-text-fill: white; -fx-font-size: 16px; -fx-font-weight: bold; -fx-padding: 0 0 20 0;"/>

            <Button text="Customers" onAction="#showCustomersPage"
                    style="-fx-background-color: transparent; -fx-text-fill: white; -fx-font-size: 14px; -fx-alignment: BASELINE_LEFT;" prefWidth="180"/>

            <Button text="Rentals" onAction="#showRentalsPage"
                    style="-fx-background-color: transparent; -fx-text-fill: white; -fx-font-size: 14px; -fx-alignment: BASELINE_LEFT;" prefWidth="180"/>

            <Button text="Employees" onAction="#showEmployeesPage"
                    style="-fx-background-color: transparent; -fx-text-fill: white; -fx-font-size: 14px; -fx-alignment: BASELINE_LEFT;" prefWidth="180"/>

            <Button text="Karts" onAction="#showKartsPage"
                    style="-fx-background-color: transparent; -fx-text-fill: white; -fx-font-size: 14px; -fx-alignment: BASELINE_LEFT;" prefWidth="180"/>

            <Button text="Equipments" onAction="#showEquipmentsPage"
                    style="-fx-background-color: transparent; -fx-text-fill: white; -fx-font-size: 14px; -fx-alignment: BASELINE_LEFT;" prefWidth="180"/>

            <Button text="Tracks" onAction="#showTracksPage"
                    style="-fx-background-color: transparent; -fx-text-fill: white; -fx-font-size: 14px; -fx-alignment: BASELINE_LEFT;" prefWidth="180"/>
        </VBox>
    </left>

    <center>
        <StackPane fx:id="contentArea" style="-fx-padding: 20;" />
    </center>

</BorderPane>