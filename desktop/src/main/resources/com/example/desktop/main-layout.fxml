<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.image.Image?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.example.desktop.controllers.MainLayoutController"
            prefHeight="600.0" prefWidth="900.0">

    <left>
        <VBox spacing="10" style="-fx-background-color: #2c3e50; -fx-padding: 20; -fx-width: 200;">

            <HBox alignment="CENTER_LEFT" style="-fx-padding: 0 0 10 0;">
                <ImageView fitWidth="260" preserveRatio="true">
                    <image>
                        <Image url="@red-kart-logo.png" />
                    </image>
                </ImageView>
            </HBox>

            <VBox spacing="5" style="-fx-padding: 0 0 20 0;">
                <Label text="User Role:" style="-fx-text-fill: #b4bcc2; -fx-font-size: 11px; -fx-font-weight: bold;" />
                <ComboBox fx:id="roleComboBox" onAction="#handleRoleChange" prefWidth="180"
                          style="-fx-background-color: #FFFFFF; -fx-text-fill: white; -fx-font-size: 13px;" />
            </VBox>

            <VBox fx:id="navLinksContainer" spacing="10">
                <Button fx:id="btnCustomers" text="Customers" onAction="#showCustomersPage"
                        style="-fx-background-color: transparent; -fx-text-fill: white; -fx-font-size: 14px; -fx-alignment: BASELINE_LEFT;" prefWidth="180"/>

                <Button fx:id="btnRentals" text="Rentals" onAction="#showRentalsPage"
                        style="-fx-background-color: transparent; -fx-text-fill: white; -fx-font-size: 14px; -fx-alignment: BASELINE_LEFT;" prefWidth="180"/>

                <Button fx:id="btnEmployees" text="Employees" onAction="#showEmployeesPage"
                        style="-fx-background-color: transparent; -fx-text-fill: white; -fx-font-size: 14px; -fx-alignment: BASELINE_LEFT;" prefWidth="180"/>

                <Button fx:id="btnKarts" text="Karts" onAction="#showKartsPage"
                        style="-fx-background-color: transparent; -fx-text-fill: white; -fx-font-size: 14px; -fx-alignment: BASELINE_LEFT;" prefWidth="180"/>

                <Button fx:id="btnEquipments" text="Equipments" onAction="#showEquipmentsPage"
                        style="-fx-background-color: transparent; -fx-text-fill: white; -fx-font-size: 14px; -fx-alignment: BASELINE_LEFT;" prefWidth="180"/>

                <Button fx:id="btnTracks" text="Tracks" onAction="#showTracksPage"
                        style="-fx-background-color: transparent; -fx-text-fill: white; -fx-font-size: 14px; -fx-alignment: BASELINE_LEFT;" prefWidth="180"/>

                <Button fx:id="btnMaintenances" text="Maintenances" onAction="#showMaintenancesPage"
                        style="-fx-background-color: transparent; -fx-text-fill: white; -fx-font-size: 14px; -fx-alignment: BASELINE_LEFT;" prefWidth="180"/>

                <Button fx:id="btnRaces" text="Races" onAction="#showRacesPage"
                        style="-fx-background-color: transparent; -fx-text-fill: white; -fx-font-size: 14px; -fx-alignment: BASELINE_LEFT;" prefWidth="180"/>
            </VBox>
        </VBox>
    </left>

    <center>
        <StackPane fx:id="contentArea" style="-fx-padding: 20;" />
    </center>

</BorderPane>