<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox spacing="15" alignment="CENTER" prefWidth="400" prefHeight="350"
      xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.example.desktop.controllers.EditEquipmentController">
    <padding><Insets top="20" right="20" bottom="20" left="20"/></padding>

    <Label text="Modify Gear Specifications" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>

    <GridPane hgap="10" vgap="10">
        <columnConstraints>
            <ColumnConstraints minWidth="120"/>
            <ColumnConstraints hgrow="ALWAYS"/>
        </columnConstraints>
        <children>
            <Label text="Type:" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
            <ComboBox fx:id="comboType" maxWidth="Infinity" GridPane.rowIndex="0" GridPane.columnIndex="1"/>

            <Label text="Size:" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
            <ComboBox fx:id="comboSize" maxWidth="Infinity" GridPane.rowIndex="1" GridPane.columnIndex="1"/>

            <Label text="Brand:" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
            <TextField fx:id="txtBrand" GridPane.rowIndex="2" GridPane.columnIndex="1"/>

            <Label text="Color Trim:" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
            <TextField fx:id="txtColor" GridPane.rowIndex="3" GridPane.columnIndex="1"/>

            <Label text="Acquisition Date:" GridPane.rowIndex="4" GridPane.columnIndex="0"/>
            <DatePicker fx:id="dpAcquisition" maxWidth="Infinity" disable="true" GridPane.rowIndex="4" GridPane.columnIndex="1"/>

            <Label text="Condition Status:" GridPane.rowIndex="5" GridPane.columnIndex="0"/>
            <ComboBox fx:id="comboStatus" maxWidth="Infinity" GridPane.rowIndex="5" GridPane.columnIndex="1"/>
        </children>
    </GridPane>

    <HBox spacing="10" alignment="CENTER_RIGHT">
        <Button text="Cancel" onAction="#cancel"/>
        <Button text="Apply Changes" onAction="#updateEquipment" style="-fx-base: #0275d8; -fx-text-fill: white; -fx-font-weight: bold;"/>
    </HBox>
</VBox>