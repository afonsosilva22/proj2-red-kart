<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane prefHeight="500.0" prefWidth="700.0"
            xmlns="http://javafx.com/javafx/17.0.12"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.example.desktop.controllers.TrackController">

    <children>
        <VBox spacing="10" AnchorPane.topAnchor="10" AnchorPane.leftAnchor="10"
              AnchorPane.rightAnchor="10" AnchorPane.bottomAnchor="10">

            <HBox spacing="10">
                <Button text="Refresh Table" onAction="#loadTracks"/>
                <Button text="Add New Track" onAction="#addTrack"/>
            </HBox>

            <TableView fx:id="table" prefHeight="300">
                <columns>
                    <TableColumn fx:id="colId" text="ID"/>
                    <TableColumn fx:id="colName" text="Track Name"/>
                    <TableColumn fx:id="colPrice" text="Price / Hour"/>
                    <TableColumn fx:id="colLength" text="Length (KM)"/>
                    <TableColumn fx:id="colLimit" text="Kart Limit"/>
                    <TableColumn fx:id="colStatus" text="Status"/>
                </columns>
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                </columnResizePolicy>
            </TableView>

            <VBox spacing="8" style="-fx-padding:10; -fx-border-color: lightgray; -fx-border-radius: 4; -fx-background-radius: 4;">
                <HBox alignment="CENTER_LEFT" spacing="10">
                    <Label text="Track Circuit Details" style="-fx-font-size:16; -fx-font-weight:bold;" />
                    <Region HBox.hgrow="ALWAYS" />
                    <Button fx:id="btnEdit" text="Edit Track" onAction="#editTrack" disable="true" style="-fx-font-weight: bold;" />
                    <Button fx:id="btnDelete" text="Close Track" onAction="#deleteTrack" disable="true" style="-fx-font-weight: bold; -fx-base: #d9534f; -fx-text-fill: white;" />
                </HBox>

                <GridPane hgap="20" vgap="6">
                    <columnConstraints>
                        <ColumnConstraints percentWidth="50.0"/>
                        <ColumnConstraints percentWidth="50.0"/>
                    </columnConstraints>
                    <children>
                        <Label fx:id="lblName" text="Track Name: " GridPane.columnIndex="0" GridPane.rowIndex="0"/>
                        <Label fx:id="lblPrice" text="Price Per Hour: " GridPane.columnIndex="1" GridPane.rowIndex="0"/>
                        <Label fx:id="lblLength" text="Circuit Length: " GridPane.columnIndex="0" GridPane.rowIndex="1"/>
                        <Label fx:id="lblLimit" text="Maximum Karts: " GridPane.columnIndex="1" GridPane.rowIndex="1"/>
                        <Label fx:id="lblStatus" text="Status: " GridPane.columnIndex="0" GridPane.rowIndex="2"/>
                    </children>
                </GridPane>
            </VBox>

        </VBox>
    </children>
</AnchorPane>